# StudyPet+ environment variables.
#
# Copy to `.env` for local dev. In the deploy environment these are injected
# automatically after push — do NOT commit a real `.env` with secrets.

# Postgres connection string (consumed by prisma/schema.prisma + src/lib/prisma.ts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/studypet?schema=public"

# Auth.js session/token signing secret. Generate with: npx auth secret
AUTH_SECRET="replace-me"

# SMTP server for magic-link emails, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER="smtp://USER:PASSWORD@HOST:587"

# From: address shown on magic-link emails
EMAIL_FROM="StudyPet+ <no-reply@studypet.example>"
