# StudyPet+ environment variables.
#
# Copy to `.env` for local dev:
#   cp .env.example .env
#
# In the deploy environment these are injected automatically after push —
# do NOT commit a real `.env` with secrets.

# Postgres (matches docker-compose.yml local defaults)
DATABASE_URL="postgresql://studypet:studypet@localhost:5432/studypet?schema=public"

# NextAuth session signing secret. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# Canonical site URL (magic-link callback origin). Use http://localhost:3000 locally.
NEXTAUTH_URL="http://localhost:3000"

# SMTP for magic-link emails (discrete vars consumed by src/auth.ts)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="USER"
EMAIL_SERVER_PASSWORD="PASSWORD"
EMAIL_FROM="StudyPet+ <no-reply@studypet.example>"

# ---- Google OAuth sign-in (US-4.S2, optional) ----
# Create an OAuth 2.0 Client ID in Google Cloud Console. Authorized redirect URI:
#   {NEXTAUTH_URL}/api/auth/callback/google
# Leave blank to disable the "Continue with Google" button (magic link still works).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- AI flashcards / quizzes (US-3.2) ----
# At least one provider is required for real generation from notes.
# Provider chain: self-hosted LLM (primary) -> Gemini (fallback).
#
# Self-hosted, OpenAI-compatible endpoint (LM Studio, vLLM, Ollama, …).
# Set BASE_URL + MODEL to make it the primary provider. BASE_URL ends at /v1;
# the app appends /chat/completions. API key is sent as a Bearer token
# (use any placeholder if your server does not require one).
LOCAL_AI_BASE_URL=""
LOCAL_AI_API_KEY=""
LOCAL_AI_MODEL=""
# Gemini — hosted fallback (or set it alone to use only Gemini).
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.1-flash-lite"
# Per-request timeout in ms (default 120000). Raise for slow self-hosted models.
# AI_REQUEST_TIMEOUT_MS="120000"
# Set to true only when you intentionally want canned demo cards (no API calls).
# AI_DEMO_MODE="false"

# ---- Docker Compose deployment only (see README "Deployment") ----
# These seed the bundled `postgres` service. The compose file builds
# DATABASE_URL from them and points the app at the `postgres` service host,
# so you do NOT edit DATABASE_URL above for the compose deploy.
# POSTGRES_USER="studypet"
# POSTGRES_PASSWORD="studypet"
# POSTGRES_DB="studypet"

# How many X-Forwarded-For entries your own proxies append, counting from the
# right. Rate limiting uses it to find the real client address; reading the
# left-most entry instead lets a caller mint a new identity per request by
# sending the header themselves.
#   0 = nothing in front of the app (or only the bundled nginx)
#   1 = one proxy in front of the bundled nginx
#   2 = the live setup: Cloudflare -> Nginx Proxy Manager -> nginx -> app
TRUSTED_PROXY_HOPS="0"
