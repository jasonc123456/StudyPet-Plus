# dependencies
/node_modules

# next.js
/.next
# Zero-downtime deploy scratch dirs: the new build lands in .next.build and the
# previous one is kept as .next.old for instant rollback (see auto-deploy.sh).
/.next.build
/.next.old
/out
next-env.d.ts

# env / secrets
.env
.env*.local

# misc
*.log
.DS_Store
tsconfig.tsbuildinfo

# local sqlite dev (temporary offline DB)
prisma/dev.db
prisma/dev.db-journal

# public
public/*

#graphify
graphify-out/*

# Private user uploads. Never under public/ — Next.js serves that statically.
uploads/
