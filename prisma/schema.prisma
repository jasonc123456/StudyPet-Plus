// Prisma schema — the single source of truth for the database shape.
// Edit models here, then run `npx prisma migrate dev` to generate SQL + the typed client.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // loaded from .env (points at the `postgres` service)
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupInviteStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ChannelType {
  TEXT
}

enum GroupTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — Sprint 1.
// These four tables are required by the Auth.js Prisma adapter. Magic-link
// sign-in tokens live in VerificationToken; no passwords are ever stored.
// Reference: https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  // IANA time zone id (e.g. "America/Los_Angeles"). Defaulted from the browser
  // at first-run onboarding; drives per-user date display. Null until onboarded.
  timezone      String?
  // Set when the user completes first-run onboarding (name + timezone + avatar).
  // Null => the dashboard redirects them to /onboarding.
  onboardedAt   DateTime?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  // Sprint 2 — planner + gamification relations.
  courses               Course[]
  quests                Quest[]
  pet                   Pet?
  notes                 Note[]
  calendarSubscriptions CalendarSubscription[]
  gradeProfile          GradeProfile?
  gradeScaleEntries     GradeScaleEntry[]
  groupsCreated         StudyGroup[]         @relation("GroupCreator")
  groupMemberships      GroupMembership[]
  groupInvitesCreated   GroupInvite[]        @relation("GroupInviteCreator")
  groupChannelsCreated  GroupChannel[]       @relation("GroupChannelCreator")
  groupMessages         GroupMessage[]       @relation("GroupMessageAuthor")
  groupTasksCreated     GroupTask[]          @relation("GroupTaskCreator")
  assignedGroupTasks    GroupTaskAssignee[]  @relation("GroupTaskAssigneeUser")
  groupTaskAssignmentsMade GroupTaskAssignee[] @relation("GroupTaskAssignedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Sprint 2 — Planner core (Courses, Assignments, Quests) + Pet shell.
//
// status/type are plain Strings (not enums) so the frontend team can add new
// values without a schema migration mid-sprint; the allowed values below are a
// convention, enforced in the API layer. Everything cascades from its owner so
// deleting a User (or a Course) cleans up its planner data.
// ---------------------------------------------------------------------------

// A class/subject the student is taking. Root of the planner hierarchy.
model Course {
  id            String    @id @default(cuid())
  userId        String
  name          String
  color         String    @default("#6366f1") // hex tag shown in the UI (indigo default)
  term          String? // e.g. "Fall 2026"; optional
  credits       Int       @default(3)
  archivedAt    DateTime?
  archiveReason String?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  notes       Note[]
  gradeCategories GradeCategory[]

  @@index([userId])
  @@index([userId, archivedAt])
}

// A graded item tied to a Course (homework, exam, project, …).
//
// calendarSubscriptionId + externalUid are set only on rows created by the ICS
// auto-sync (US: "auto sync calendar feed → assignments"). Together they are the
// idempotency key: a re-sync upserts on (subscription, uid) so a feed can be
// pulled repeatedly without duplicating rows. Both are null for hand-made
// assignments, and Postgres treats NULLs as distinct, so the unique constraint
// never blocks two manual assignments.
model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  description String?
  dueAt       DateTime? // planner sorts by this; nullable for "someday" items
  status      String    @default("todo") // todo | in_progress | done
  type        String    @default("homework") // homework | exam | project | reading | other
  createdAt   DateTime  @default(now())

  calendarSubscriptionId String?
  externalUid            String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  calendarSubscription CalendarSubscription? @relation(fields: [calendarSubscriptionId], references: [id], onDelete: SetNull)
  gradeItems GradeItem[]

  @@unique([calendarSubscriptionId, externalUid])
  @@index([courseId])
  @@index([calendarSubscriptionId])
}

// A lightweight study goal/task owned directly by the user (not course-bound).
// xpReward exists now; the XP payout logic lands in Sprint 4.
model Quest {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  dueAt       DateTime?
  status      String    @default("todo") // todo | in_progress | done
  difficulty  String    @default("medium") // easy | medium | hard
  xpReward    Int       @default(10)
  estimatedMinutes Int?
  rewardClaimed Boolean @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The gamified study pet. One per user. Sprint 2 stores static placeholder
// state; the live XP/streak/evolution logic arrives in Sprint 4.
model Pet {
  id            String    @id @default(cuid())
  userId        String    @unique // one pet per user
  name          String    @default("StudyPet")
  xp            Int       @default(0)
  level         Int       @default(1)
  stage         String    @default("egg") // egg | hatchling | chick | owl | dragon
  streakCount   Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarSubscription {
  id           String   @id @default(cuid())
  userId       String
  name         String
  icsUrl       String
  color        String   @default("#0ea5e9")
  // Opt-in: when true, feed events are materialized as Assignment rows so they
  // show up on the assignments page. Off by default — the calendar still
  // renders the feed read-only either way.
  autoSync     Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastSyncedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncedAssignments Assignment[]
  ignoredEvents CalendarIgnoredEvent[]

  @@index([userId])
  @@unique([userId, icsUrl])
}

// A feed event the user has marked "not an assignment" (a Zoom link, a lecture,
// an exam they don't want tracked). Auto-sync skips these UIDs forever; the
// event still renders on the calendar, just greyed out and un-ignorable.
model CalendarIgnoredEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  uid            String
  title          String
  createdAt      DateTime @default(now())

  subscription CalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, uid])
  @@index([subscriptionId])
}

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  customRoles GroupCustomRole[]
  invites     GroupInvite[]
  channels    GroupChannel[]
  messages    GroupMessage[]
  tasks       GroupTask[]

  @@index([createdById])
}

model GroupMembership {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  customRoleId String?
  joinedAt DateTime  @default(now())

  group      StudyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole GroupCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
  @@index([customRoleId])
}

model GroupCustomRole {
  id        String   @id @default(cuid())
  groupId    String
  name       String
  color      String   @default("#2563eb")
  createdAt  DateTime @default(now())

  group       StudyGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]

  @@unique([groupId, name])
  @@index([groupId])
}

model GroupInvite {
  id         String            @id @default(cuid())
  groupId     String
  createdById String
  tokenHash   String            @unique
  status      GroupInviteStatus @default(ACTIVE)
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int               @default(0)
  createdAt   DateTime          @default(now())

  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User       @relation("GroupInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model GroupChannel {
  id          String      @id @default(cuid())
  groupId      String
  createdById  String
  name         String
  description  String?
  type         ChannelType @default(TEXT)
  position     Int         @default(0)
  createdAt    DateTime    @default(now())

  group     StudyGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User          @relation("GroupChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages  GroupMessage[]
  tasks     GroupTask[]

  @@unique([groupId, name])
  @@index([groupId, position])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId    String
  channelId  String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  editedAt   DateTime?

  group   StudyGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channel GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User         @relation("GroupMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([authorId])
}

model GroupTask {
  id          String          @id @default(cuid())
  groupId      String
  createdById  String
  channelId    String?
  title        String
  description  String?
  dueAt        DateTime?
  status       GroupTaskStatus @default(TODO)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  group     StudyGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User               @relation("GroupTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  channel   GroupChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignees GroupTaskAssignee[]

  @@index([groupId, dueAt])
  @@index([channelId])
  @@index([status])
}

model GroupTaskAssignee {
  id           String   @id @default(cuid())
  taskId        String
  userId        String
  assignedAt    DateTime @default(now())
  assignedById  String

  task       GroupTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User      @relation("GroupTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User      @relation("GroupTaskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Sprint 3 (US-3.1) — Notes.
//
// User-owned study notes, optionally linked to a Course. Note.content is the
// source text future AI flashcard/quiz generation (US-3.2+) will read from.
// ---------------------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  userId    String
  courseId  String? // null = uncategorized note
  title     String
  content   String   @default("")
  pdfName   String?
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([updatedAt])
}

model GradeProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentGpa       Float?
  completedCredits Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GradeScaleEntry {
  id         String   @id @default(cuid())
  userId     String
  label      String
  minPercent Float
  maxPercent Float
  gpaPoints  Float
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sortOrder])
}

model GradeCategory {
  id        String   @id @default(cuid())
  courseId   String
  name       String
  weight     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  GradeItem[]

  @@unique([courseId, name])
  @@index([courseId])
}

model GradeItem {
  id            String    @id @default(cuid())
  categoryId     String
  assignmentId   String?
  title          String
  scoreEarned    Float
  scorePossible  Float
  notes          String?
  gradedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   GradeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignment Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([assignmentId])
}
