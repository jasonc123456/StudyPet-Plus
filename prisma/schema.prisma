// Prisma schema — the single source of truth for the database shape.
// Edit models here, then run `npx prisma migrate dev` to generate SQL + the typed client.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // loaded from .env (points at the `postgres` service)
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupInviteStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ChannelType {
  TEXT
}

enum GroupTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum AcademicSystem {
  SEMESTER
  QUARTER
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — Sprint 1.
// These four tables are required by the Auth.js Prisma adapter. Magic-link
// sign-in tokens live in VerificationToken; no passwords are ever stored.
// Reference: https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  // IANA time zone id (e.g. "America/Los_Angeles"). Defaulted from the browser
  // at first-run onboarding; drives per-user date display. Null until onboarded.
  timezone      String?
  // Set when the user completes first-run onboarding (name + timezone + avatar).
  // Null => the dashboard redirects them to /onboarding.
  onboardedAt   DateTime?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Calendar preference (Sprint 3, added mid-sprint). When true, /dashboard/calendar
  // shows every dated task from the groups this user belongs to, not just the ones
  // assigned to them. Off by default so the personal calendar stays quiet until asked.
  showAllGroupTasksOnCalendar Boolean @default(false)
  createdAt     DateTime  @default(now())

  // sha256 of the raw token embedded in the outbound ICS feed URL
  // (/api/calendar/feed/[token].ics). Null until the user generates a link;
  // rotating it (regenerating) invalidates every calendar app subscribed to
  // the old one. Hashed like group invite tokens (see hashInviteToken) so a
  // leaked DB row can't be used to mint a working feed URL.
  calendarFeedTokenHash String? @unique

  // ---- Multi-factor auth (US-4.S1) ----
  // totpSecret holds the *active* base32 TOTP secret; totpActivatedAt is the
  // moment it became a real factor. Enrollment never writes to either: a new
  // secret lands in totpPendingSecret and is promoted only once the user
  // proves possession by entering a valid code. Keeping the two apart means a
  // re-enrollment cannot destroy the working factor before the replacement is
  // proven. Passkeys live in the Authenticator table and their in-flight
  // ceremonies in WebAuthnChallenge — one row per session, not one slot per user.
  // totpFailedAttempts/totpLockedUntil throttle online guessing of the six-digit
  // code. They live on the row rather than in process memory because a limiter
  // that resets on deploy, or that a second replica doesn't see, is not a limit
  // on an authentication factor.
  totpSecret         String?
  totpPendingSecret  String?
  totpActivatedAt    DateTime?
  totpFailedAttempts Int       @default(0)
  totpLockedUntil    DateTime?

  accounts Account[]
  sessions Session[]
  authenticators Authenticator[]
  webAuthnChallenges WebAuthnChallenge[]
  pendingUploads     PendingUpload[]
  importDrafts       ImportDraft[]
  emailChangeRequests EmailChangeRequest[]

  // Sprint 2 — planner + gamification relations.
  courses               Course[]
  quests                Quest[]
  pet                   Pet?
  notes                 Note[]
  flashcards            Flashcard[]
  flashcardSets         FlashcardSet[]
  flashcardReviewAwards FlashcardReviewAward[]
  quizzes               Quiz[]
  quizQuestions         QuizQuestion[]
  quizAttempts          QuizAttempt[]
  quizQuestionResults   QuizQuestionResult[]
  quizXpAwards          QuizXpAward[]
  calendarSubscriptions CalendarSubscription[]
  gradeProfile          GradeProfile?
  gradeScaleEntries     GradeScaleEntry[]
  coursePlanners        CoursePlanner[]
  personalEvents        PersonalEvent[]
  groupsCreated         StudyGroup[]         @relation("GroupCreator")
  groupMemberships      GroupMembership[]
  groupInvitesCreated   GroupInvite[]        @relation("GroupInviteCreator")
  groupChannelsCreated  GroupChannel[]       @relation("GroupChannelCreator")
  groupMessages         GroupMessage[]       @relation("GroupMessageAuthor")
  groupTasksCreated     GroupTask[]          @relation("GroupTaskCreator")
  assignedGroupTasks    GroupTaskAssignee[]  @relation("GroupTaskAssigneeUser")
  groupTaskAssignmentsMade GroupTaskAssignee[] @relation("GroupTaskAssignedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Set once this session clears the second factor (US-4.S1). Null right after
  // sign-in when the user has MFA enabled — the /mfa gate fills it in. A fresh
  // login mints a new session row (null again), so re-authentication always
  // requires the second factor. Null-by-default means MFA-free users and every
  // pre-existing session are unaffected.
  mfaVerifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A registered WebAuthn passkey / security key (US-4.S1). One row per
// credential; a user may enroll several. publicKey + counter are used to verify
// each assertion; counter is bumped on every successful authentication to catch
// cloned authenticators.
model Authenticator {
  id           String   @id @default(cuid())
  userId       String
  credentialID String   @unique // base64url-encoded credential id
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String? // comma-joined hints, e.g. "internal,hybrid"
  deviceName   String? // user-facing label
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// A pending "change my email address" request. Created when a signed-in user
// asks to switch their account email in Settings; the switch is NOT applied
// until they click the link mailed to the NEW address (proving they control
// that inbox). Without this step a typo'd address would silently take over the
// account and lock the user out on their next magic-link sign-in.
//
// tokenHash stores a SHA-256 of the random token that goes in the email link —
// never the raw token — so a database read can't be replayed as a valid link.
model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Sprint 2 — Planner core (Courses, Assignments, Quests) + Pet shell.
//
// status/type are plain Strings (not enums) so the frontend team can add new
// values without a schema migration mid-sprint; the allowed values below are a
// convention, enforced in the API layer. Everything cascades from its owner so
// deleting a User (or a Course) cleans up its planner data.
// ---------------------------------------------------------------------------

// A class/subject the student is taking. Root of the planner hierarchy.
model Course {
  id            String    @id @default(cuid())
  userId        String
  name          String
  color         String    @default("#6366f1") // hex tag shown in the UI (indigo default)
  term          String? // e.g. "Fall 2026"; optional
  credits       Int       @default(3)
  archivedAt    DateTime?
  archiveReason String?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  notes       Note[]
  flashcards  Flashcard[]
  flashcardSets FlashcardSet[]
  quizzes     Quiz[]
  gradeCategories GradeCategory[]

  @@index([userId])
  @@index([userId, archivedAt])
}

// A graded item tied to a Course (homework, exam, project, …).
//
// calendarSubscriptionId + externalUid are set only on rows created by the ICS
// auto-sync (US: "auto sync calendar feed → assignments"). Together they are the
// idempotency key: a re-sync upserts on (subscription, uid) so a feed can be
// pulled repeatedly without duplicating rows. Both are null for hand-made
// assignments, and Postgres treats NULLs as distinct, so the unique constraint
// never blocks two manual assignments.
model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  description String?
  dueAt       DateTime? // planner sorts by this; nullable for "someday" items
  status      String    @default("todo") // todo | in_progress | done
  type        String    @default("homework") // homework | exam | project | reading | other
  createdAt   DateTime  @default(now())

  calendarSubscriptionId String?
  externalUid            String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  calendarSubscription CalendarSubscription? @relation(fields: [calendarSubscriptionId], references: [id], onDelete: SetNull)
  gradeItems GradeItem[]

  @@unique([calendarSubscriptionId, externalUid])
  @@index([courseId])
  @@index([calendarSubscriptionId])
}

// A lightweight study goal/task owned directly by the user (not course-bound).
// xpReward exists now; the XP payout logic lands in Sprint 4.
model Quest {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  dueAt       DateTime?
  status      String    @default("todo") // todo | in_progress | done
  difficulty  String    @default("medium") // easy | medium | hard
  xpReward    Int       @default(10)
  estimatedMinutes Int?
  rewardClaimed Boolean @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The gamified study pet. One per user. Sprint 2 stores static placeholder
// state; the live XP/streak/evolution logic arrives in Sprint 4.
model Pet {
  id            String    @id @default(cuid())
  userId        String    @unique // one pet per user
  name          String    @default("StudyPet")
  xp            Int       @default(0)
  level         Int       @default(1)
  stage         String    @default("egg") // egg | hatchling | baby | toddler | teen | adult | beast
  streakCount   Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A plain, user-owned calendar entry with nothing behind it — no course,
// quest, or group ("Dentist appointment", "Study group hangout"). Added
// Sprint 4 so the calendar page isn't limited to auto-generated planner items.
model PersonalEvent {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean   @default(false)
  color       String    @default("#64748b")
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startsAt])
}

model CalendarSubscription {
  id           String   @id @default(cuid())
  userId       String
  name         String
  icsUrl       String
  color        String   @default("#0ea5e9")
  // Opt-in: when true, feed events are materialized as Assignment rows so they
  // show up on the assignments page. Off by default — the calendar still
  // renders the feed read-only either way.
  autoSync     Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastSyncedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncedAssignments Assignment[]
  ignoredEvents CalendarIgnoredEvent[]

  @@index([userId])
  @@unique([userId, icsUrl])
}

// A feed event the user has marked "not an assignment" (a Zoom link, a lecture,
// an exam they don't want tracked). Auto-sync skips these UIDs forever; the
// event still renders on the calendar, just greyed out and un-ignorable.
model CalendarIgnoredEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  uid            String
  title          String
  createdAt      DateTime @default(now())

  subscription CalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, uid])
  @@index([subscriptionId])
}

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  customRoles GroupCustomRole[]
  invites     GroupInvite[]
  channels    GroupChannel[]
  messages    GroupMessage[]
  tasks       GroupTask[]

  @@index([createdById])
}

model GroupMembership {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  customRoleId String?
  joinedAt DateTime  @default(now())

  group      StudyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole GroupCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
  @@index([customRoleId])
}

model GroupCustomRole {
  id        String   @id @default(cuid())
  groupId    String
  name       String
  color      String   @default("#2563eb")
  createdAt  DateTime @default(now())

  group       StudyGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]

  @@unique([groupId, name])
  @@index([groupId])
}

model GroupInvite {
  id         String            @id @default(cuid())
  groupId     String
  createdById String
  tokenHash   String            @unique
  status      GroupInviteStatus @default(ACTIVE)
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int               @default(0)
  createdAt   DateTime          @default(now())

  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User       @relation("GroupInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model GroupChannel {
  id          String      @id @default(cuid())
  groupId      String
  createdById  String
  name         String
  description  String?
  type         ChannelType @default(TEXT)
  position     Int         @default(0)
  createdAt    DateTime    @default(now())

  group     StudyGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User          @relation("GroupChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages  GroupMessage[]
  tasks     GroupTask[]

  @@unique([groupId, name])
  @@index([groupId, position])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId    String
  channelId  String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  editedAt   DateTime?

  group   StudyGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channel GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User         @relation("GroupMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([authorId])
}

model GroupTask {
  id          String          @id @default(cuid())
  groupId      String
  createdById  String
  channelId    String?
  title        String
  description  String?
  dueAt        DateTime?
  status       GroupTaskStatus @default(TODO)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  group     StudyGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User               @relation("GroupTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  channel   GroupChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignees GroupTaskAssignee[]

  @@index([groupId, dueAt])
  @@index([channelId])
  @@index([status])
}

model GroupTaskAssignee {
  id           String   @id @default(cuid())
  taskId        String
  userId        String
  assignedAt    DateTime @default(now())
  assignedById  String

  task       GroupTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User      @relation("GroupTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User      @relation("GroupTaskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Sprint 3 (US-3.1) — Notes.
//
// User-owned study notes, optionally linked to a Course. Note.content is the
// source text future AI flashcard/quiz generation (US-3.2+) will read from.
// ---------------------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  userId    String
  courseId  String? // null = uncategorized note
  title     String
  content   String   @default("")
  pdfName   String?
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  flashcards Flashcard[]
  quizzes    Quiz[]
  quizSources      QuizSourceNote[]
  flashcardSources FlashcardSourceNote[]

  @@index([userId])
  @@index([courseId])
  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Sprint 3 (US-3.3) — Flashcards.
//
// AI-generated topic-tagged cards persisted from a Note's content. `front` /
// `back` match the US-3.2 AI contract; `courseId` is copied from the parent
// Note at generation time (null when the note is uncategorized).
// ---------------------------------------------------------------------------

model Flashcard {
  id        String   @id @default(cuid())
  userId    String
  // Legacy single-note link, kept nullable. The set's source notes are the
  // source of truth (FlashcardSourceNote); a set may span several notes.
  noteId    String?
  setId     String? // owning deck; every card generated after the redesign has one
  courseId  String? // copied from the deck at generation; null if uncategorized
  topic     String
  front     String // question side
  back      String // answer side
  createdAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  note   Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  set    FlashcardSet? @relation(fields: [setId], references: [id], onDelete: Cascade)
  course Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  reviewAwards FlashcardReviewAward[]

  @@index([userId])
  @@index([noteId])
  @@index([setId])
  @@index([courseId])
  @@index([topic])
}

// A flashcard deck: one generation batch built from 1..N source notes. Cards
// hang off it via Flashcard.setId; the notes it was built from are recorded in
// FlashcardSourceNote.
model FlashcardSet {
  id        String   @id @default(cuid())
  userId    String
  title     String
  courseId  String? // shared course when all source notes agree, else null
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  cards       Flashcard[]
  sourceNotes FlashcardSourceNote[]

  @@index([userId])
  @@index([courseId])
}

// Join row linking a FlashcardSet to one of its source notes.
model FlashcardSourceNote {
  id     String @id @default(cuid())
  setId  String
  noteId String

  set  FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  note Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([setId, noteId])
  @@index([setId])
  @@index([noteId])
}

// Sprint 3 (US-3.6) — one row per flashcard-review XP grant. The unique
// (userId, flashcardId, awardedOn) key caps the payout at once per card per
// UTC day, so re-marking a card (same session, a reload, or a repeat pass)
// can't farm XP, while a genuine review on a later day earns again.
model FlashcardReviewAward {
  id          String   @id @default(cuid())
  userId      String
  flashcardId String
  awardedOn   String // UTC calendar day, "YYYY-MM-DD"
  xp          Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId, awardedOn])
  @@index([userId])
  @@index([flashcardId])
}

// ---------------------------------------------------------------------------
// Sprint 3 (US-3.4) — Quizzes.
//
// AI-generated multiple-choice quizzes persisted from a Note's content. Each
// Quiz is one generation batch; QuizQuestion rows map to the US-3.2 AI contract
// (`answerIndex` → `correctIndex` at persistence time).
// ---------------------------------------------------------------------------

model Quiz {
  id        String   @id @default(cuid())
  userId    String
  title     String? // user-editable label; smart default at generation
  // Legacy single-note link, kept nullable. Source notes live in QuizSourceNote;
  // a quiz may be built from several notes.
  noteId    String?
  courseId  String? // shared course when all source notes agree, else null
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        Note?            @relation(fields: [noteId], references: [id], onDelete: SetNull)
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  xpAwards    QuizXpAward[]
  sourceNotes QuizSourceNote[]

  @@index([userId])
  @@index([noteId])
  @@index([courseId])
}

// Join row linking a Quiz to one of its source notes.
model QuizSourceNote {
  id     String @id @default(cuid())
  quizId String
  noteId String

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([quizId, noteId])
  @@index([quizId])
  @@index([noteId])
}

model QuizQuestion {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  topic        String
  question     String
  choices      String[]
  correctIndex Int
  explanation  String?
  // Per-choice rationale, parallel to `choices`: for each wrong option a short
  // "why this is incorrect"; empty string at the correct index. Generated once
  // at quiz-generation time so completing a quiz needs no live AI call.
  choiceRationales String[] @default([])
  hint         String? // AI-generated nudge; shown in Review/Practice modes
  createdAt    DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  results QuizQuestionResult[]

  @@index([userId])
  @@index([quizId])
  @@index([topic])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  clientAttemptId String?
  correctCount   Int
  totalQuestions Int
  scorePercent   Int
  xpAwarded      Int      @default(0)
  createdAt      DateTime @default(now())

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz            Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionResults QuizQuestionResult[]

  @@index([userId, createdAt])
  @@index([quizId, createdAt])
  @@unique([userId, clientAttemptId])
}

// US-4.05 — the permanent marker that a user earned a quiz's full reward.
// Partial attempts award their score-tier XP without creating this row. Once
// the user answers every question correctly, this unique row marks the quiz
// done and prevents all later attempts from awarding more XP.
model QuizXpAward {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  xp        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
}

model QuizQuestionResult {
  id            String   @id @default(cuid())
  userId        String
  attemptId     String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  createdAt     DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([userId, createdAt])
  @@index([questionId])
  @@index([isCorrect])
}

model CoursePlanner {
  id        String         @id @default(cuid())
  userId    String
  title     String
  system    AcademicSystem
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections CoursePlannerSection[]

  @@index([userId])
}

model CoursePlannerSection {
  id        String   @id @default(cuid())
  plannerId  String
  label      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  planner CoursePlanner @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  courses PlannedCourse[]

  @@index([plannerId])
  @@index([plannerId, sortOrder])
}

model PlannedCourse {
  id              String   @id @default(cuid())
  sectionId        String
  title            String
  courseNumber     String?
  units            Float?
  professor        String?
  lectureDays      String?
  lectureTime      String?
  lectureLocation  String?
  isAlternate      Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  section CoursePlannerSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([sectionId, isAlternate])
}

model GradeProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentGpa       Float?
  completedCredits Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GradeScaleEntry {
  id         String   @id @default(cuid())
  userId     String
  label      String
  minPercent Float
  maxPercent Float
  gpaPoints  Float
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sortOrder])
}

model GradeCategory {
  id        String   @id @default(cuid())
  courseId   String
  name       String
  weight     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  GradeItem[]

  @@unique([courseId, name])
  @@index([courseId])
}

model GradeItem {
  id            String    @id @default(cuid())
  categoryId     String
  assignmentId   String?
  title          String
  scoreEarned    Float
  scorePossible  Float
  notes          String?
  gradedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   GradeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignment Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([assignmentId])
}

/// One in-flight WebAuthn ceremony.
///
/// This used to be a single `currentChallenge` string on User, which made every
/// ceremony for an account share one slot: starting a registration overwrote a
/// passkey sign-in that was already in progress, a second tab overwrote the
/// first, and anyone holding a pre-MFA session could invalidate the real user's
/// challenge on repeat. A row per (session, ceremony) lets independent ceremonies
/// run at once, and gives each one an expiry and a single-use guarantee.
///
/// challengeHash is a SHA-256 of the challenge, never the challenge itself —
/// verification hashes what the browser returns and compares, so a database read
/// alone does not hand over a usable ceremony value.
model WebAuthnChallenge {
  id            String           @id @default(cuid())
  userId        String
  /// Binds the ceremony to the session that started it.
  sessionToken  String
  ceremony      WebAuthnCeremony
  challengeHash String
  expiresAt     DateTime
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionToken, ceremony])
  @@index([userId])
  @@index([expiresAt])
}

enum WebAuthnCeremony {
  AUTHENTICATION
  REGISTRATION
}

/// A note attachment that has been written to disk but not yet attached to a
/// Note.
///
/// The upload endpoint accepts up to 10 MiB and writes it straight to the
/// temporary directory. Without a record of that file there was nothing to
/// enforce a quota against and nothing to clean up: a client that simply never
/// finished the note left the bytes on disk forever, and repeating that filled
/// the volume. Each pending file now has an owner, a size and an expiry, so
/// uploads can be budgeted per user and abandoned ones swept.
model PendingUpload {
  /// The on-disk temporary filename, e.g. "upload-<uuid>.pdf".
  id        String   @id
  userId    String
  byteSize  Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Permission to run one planner import.
///
/// Confirming an import writes up to 600 planned courses. The size of a single
/// request was capped, but nothing stopped the same request being replayed, so
/// repeating it grew the database without bound and re-opened the transaction
/// each time. Parsing a plan now mints one of these, and confirming consumes it
/// — a replayed confirmation finds nothing to consume and does no work.
///
/// The draft contents are not stored here: the user edits the preview before
/// confirming, so the courses still arrive with the confirmation. This row is
/// the permission, not the payload.
model ImportDraft {
  id        String   @id @default(cuid())
  userId    String
  plannerId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
